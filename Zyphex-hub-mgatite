                Btn.TextXAlignment = Enum.TextXAlignment.Left
                Btn.MouseEnter:Connect(function()
                    TweenService:Create(Btn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(220, 220, 230)}):Play()
                end)
                Btn.MouseLeave:Connect(function()
                    TweenService:Create(Btn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(105, 105, 115)}):Play()
                end)
                Btn.MouseButton1Click:Connect(function()
                    if cfg.Callback then cfg.Callback() end
                end)
            end

            function Section:AddToggle(cfg)
                cfg = cfg or {}
                local state = cfg.Default or false
                local F = Instance.new("TextButton", SCt)
                F.Size = UDim2.new(1, 0, 0, 20)
                F.BackgroundTransparency = 1
                F.Text = ""
                F.AutoButtonColor = false

                local L = Instance.new("TextLabel", F)
                L.Size = UDim2.new(1, -24, 1, 0)
                L.BackgroundTransparency = 1
                L.FontFace = FONT_MEDIUM
                L.Text = cfg.Name or "Toggle"
                L.TextColor3 = state and COLOR_TEXT_WHITE or COLOR_TEXT_MUTED
                L.TextSize = 12
                L.TextXAlignment = Enum.TextXAlignment.Left

                local Bx = Instance.new("Frame", F)
                Bx.Size = UDim2.new(0, 16, 0, 16)
                Bx.Position = UDim2.new(1, 0, 0.5, 0)
                Bx.AnchorPoint = Vector2.new(1, 0.5)
                Bx.BackgroundColor3 = state and COLOR_TEXT_WHITE or COLOR_BOX_INACTIVE
                Bx.BorderSizePixel = 0
                Instance.new("UICorner", Bx).CornerRadius = UDim.new(0, 4)
                local bxs = Instance.new("UIStroke", Bx)
                bxs.Color = state and COLOR_TEXT_WHITE or COLOR_BOX_BORDER
                bxs.Thickness = 1

                local CI = Instance.new("ImageLabel", Bx)
                CI.Size = UDim2.new(0, 10, 0, 10)
                CI.Position = UDim2.new(0.5, 0, 0.5, 0)
                CI.AnchorPoint = Vector2.new(0.5, 0.5)
                CI.BackgroundTransparency = 1
                CI.ImageColor3 = COLOR_BG
                CI.ImageTransparency = state and 0 or 1
                ApplyIcon(CI, "check")

                local function Refresh()
                    Bx.BackgroundColor3 = state and COLOR_TEXT_WHITE or COLOR_BOX_INACTIVE
                    bxs.Color = state and COLOR_TEXT_WHITE or COLOR_BOX_BORDER
                    CI.ImageTransparency = state and 0 or 1
                    L.TextColor3 = state and COLOR_TEXT_WHITE or COLOR_TEXT_MUTED
                end

                F.MouseButton1Click:Connect(function()
                    state = not state
                    Refresh()
                    if cfg.Callback then cfg.Callback(state) end
                end)

                return {
                    Set = function(v) state = v Refresh() if cfg.Callback then cfg.Callback(state) end end,
                    Get = function() return state end
                }
            end

            function Section:AddSlider(cfg)
                cfg = cfg or {}
                local mn, mx = cfg.Min or 0, cfg.Max or 100
                local val = math.clamp(cfg.Default or mn, mn, mx)
                local dragging = false

                local F = Instance.new("Frame", SCt)
                F.Size = UDim2.new(1, 0, 0, 34)
                F.BackgroundTransparency = 1

                local L = Instance.new("TextLabel", F)
                L.Size = UDim2.new(0.6, 0, 0, 16)
                L.BackgroundTransparency = 1
                L.FontFace = FONT_MEDIUM
                L.Text = cfg.Name or "Slider"
                L.TextColor3 = COLOR_TEXT_WHITE
                L.TextSize = 12
                L.TextXAlignment = Enum.TextXAlignment.Left

                local VL = Instance.new("TextLabel", F)
                VL.Size = UDim2.new(0.4, 0, 0, 16)
                VL.Position = UDim2.new(1, 0, 0, 0)
                VL.AnchorPoint = Vector2.new(1, 0)
                VL.BackgroundTransparency = 1
                VL.FontFace = FONT_REGULAR
                VL.Text = tostring(val)
                VL.TextColor3 = COLOR_TEXT_MUTED
                VL.TextSize = 11
                VL.TextXAlignment = Enum.TextXAlignment.Right

                local Tr = Instance.new("Frame", F)
                Tr.Size = UDim2.new(1, 0, 0, 4)
                Tr.Position = UDim2.new(0, 0, 0, 22)
                Tr.BackgroundColor3 = COLOR_BOX_INACTIVE
                Tr.BorderSizePixel = 0
                Instance.new("UICorner", Tr).CornerRadius = UDim.new(1, 0)

                local Fl = Instance.new("Frame", Tr)
                Fl.Size = UDim2.new((val - mn) / (mx - mn), 0, 1, 0)
                Fl.BackgroundColor3 = COLOR_TEXT_WHITE
                Fl.BorderSizePixel = 0
                Instance.new("UICorner", Fl).CornerRadius = UDim.new(1, 0)

                local Knob = Instance.new("Frame", Tr)
                Knob.Size = UDim2.new(0, 12, 0, 12)
                Knob.AnchorPoint = Vector2.new(0.5, 0.5)
                Knob.Position = UDim2.new((val - mn) / (mx - mn), 0, 0.5, 0)
                Knob.BackgroundColor3 = COLOR_TEXT_WHITE
                Knob.BorderSizePixel = 0
                Knob.ZIndex = 3
                Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

                local function SetPos(pct)
                    Fl.Size = UDim2.new(pct, 0, 1, 0)
                    Knob.Position = UDim2.new(pct, 0, 0.5, 0)
                end
                local function Update(input)
                    local px = math.clamp(input.Position.X - Tr.AbsolutePosition.X, 0, Tr.AbsoluteSize.X)
                    local pct = math.clamp(px / Tr.AbsoluteSize.X, 0, 1)
                    val = math.floor(mn + (mx - mn) * pct + 0.5)
                    SetPos(pct)
                    VL.Text = tostring(val)
                    if cfg.Callback then cfg.Callback(val) end
                end
                Tr.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        Update(i)
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then Update(i) end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
            end

            function Section:AddDropdown(cfg)
                cfg = cfg or {}
                local options = cfg.Options or {}
                local selected = cfg.Default

                local F = Instance.new("Frame", SCt)
                F.Size = UDim2.new(1, 0, 0, 20)
                F.BackgroundTransparency = 1

                local Btn = Instance.new("TextButton", F)
                Btn.Size = UDim2.new(1, 0, 1, 0)
                Btn.BackgroundTransparency = 1
                Btn.Text = ""
                Btn.AutoButtonColor = false

                local L = Instance.new("TextLabel", Btn)
                L.Size = UDim2.new(0.5, 0, 1, 0)
                L.BackgroundTransparency = 1
                L.FontFace = FONT_MEDIUM
                L.Text = cfg.Name or "Dropdown"
                L.TextColor3 = COLOR_TEXT_WHITE
                L.TextSize = 12
                L.TextXAlignment = Enum.TextXAlignment.Left

                local V = Instance.new("TextLabel", Btn)
                V.Size = UDim2.new(0.5, -12, 1, 0)
                V.Position = UDim2.new(0.5, 0, 0, 0)
                V.BackgroundTransparency = 1
                V.FontFace = FONT_REGULAR
                V.Text = selected and tostring(selected) or "None"
                V.TextColor3 = COLOR_TEXT_MUTED
                V.TextSize = 11
                V.TextXAlignment = Enum.TextXAlignment.Right

                local LF = Instance.new("Frame", SCt)
                LF.Size = UDim2.new(1, 0, 0, 0)
                LF.BackgroundColor3 = COLOR_BOX_INACTIVE
                LF.BorderSizePixel = 0
                LF.ClipsDescendants = true
                LF.Visible = false
                Instance.new("UICorner", LF).CornerRadius = UDim.new(0, 6)
                local ls = Instance.new("UIStroke", LF)
                ls.Color = COLOR_BOX_BORDER
                ls.Thickness = 1
                local ll = Instance.new("UIListLayout", LF)
                ll.Padding = UDim.new(0, 2)
                local lp = Instance.new("UIPadding", LF)
                lp.PaddingTop = UDim.new(0, 4)
                lp.PaddingBottom = UDim.new(0, 4)
                lp.PaddingLeft = UDim.new(0, 8)
                lp.PaddingRight = UDim.new(0, 8)

                local isOpen = false
                for _, opt in ipairs(options) do
                    local Ob = Instance.new("TextButton", LF)
                    Ob.Size = UDim2.new(1, 0, 0, 18)
                    Ob.BackgroundTransparency = 1
                    Ob.Text = tostring(opt)
                    Ob.TextColor3 = COLOR_TEXT_MUTED
                    Ob.TextSize = 11
                    Ob.TextXAlignment = Enum.TextXAlignment.Left
                    Ob.FontFace = FONT_MEDIUM
                    Ob.AutoButtonColor = false
                    Ob.MouseEnter:Connect(function() Ob.TextColor3 = COLOR_TEXT_WHITE end)
                    Ob.MouseLeave:Connect(function() Ob.TextColor3 = COLOR_TEXT_MUTED end)
                    Ob.MouseButton1Click:Connect(function()
                        selected = opt
                        V.Text = tostring(opt)
                        isOpen = false
                        LF.Visible = false
                        LF.Size = UDim2.new(1, 0, 0, 0)
                        if cfg.Callback then cfg.Callback(opt) end
                    end)
                end

                Btn.MouseButton1Click:Connect(function()
                    isOpen = not isOpen
                    LF.Visible = isOpen
                    LF.Size = isOpen and UDim2.new(1, 0, 0, #options * 20 + 8) or UDim2.new(1, 0, 0, 0)
                end)

                return {
                    Set = function(v)
                        selected = v
                        V.Text = tostring(v)
                        if cfg.Callback then cfg.Callback(v) end
                    end,
                    Get = function() return selected end
                }
            end

            return Section
        end

        if #self._tabs == 0 then
            CP.Visible = true
            self._activeTabRef = tabObj
            SetTabActive(tabObj, true)
            UpdateHeader(tabName, tabIcon)
        end
        table.insert(self._tabs, tabObj)
        return Tab
    end

    return Window
end

